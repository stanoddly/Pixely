<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net11.0;net11.0-browser</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <InterceptorsNamespaces>$(InterceptorsNamespaces);Pixely.DependencyInjection.Generated</InterceptorsNamespaces>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Pixely.Tests" />
        <!-- Painting text needs a text sprite, which needs a Texture, whose constructor is
             internal. Laying a Label out needs neither. -->
        <InternalsVisibleTo Include="Pixely.Ui.Tests" />
        <!-- The model tests decode a texture embedded in a model with SdlImageDecoder. -->
        <InternalsVisibleTo Include="Pixely.Models.Tests" />
        <!-- The stub GPU device derives from GpuDevice and the other backend types, whose backend members are internal. -->
        <InternalsVisibleTo Include="Pixely.Testing" />
        <!-- Headless mode registers its services, windows and clock through the internal seams of the app. -->
        <InternalsVisibleTo Include="Pixely.Headless" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="ppy.SDL3-CS" />
      <PackageReference Include="ppy.SDL3_image-CS" />
      <PackageReference Include="ppy.SDL3_ttf-CS" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Pixely.Collections\Pixely.Collections.csproj" />
      <ProjectReference Include="..\Pixely.DependencyInjection\Pixely.DependencyInjection.csproj" />
      <ProjectReference Include="..\Pixely.DependencyInjection.Generator\Pixely.DependencyInjection.Generator.csproj"
                        OutputItemType="Analyzer"
                        ReferenceOutputAssembly="false" />
      <ProjectReference Include="..\Pixely.Core\Pixely.Core.csproj" />
      <ProjectReference Include="..\Pixely.ShaderCommon\Pixely.ShaderCommon.csproj" />
    </ItemGroup>

</Project>
