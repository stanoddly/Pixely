<Project>
    <PropertyGroup>
        <SlangDxcToolchainVersion>2026.19.0.1</SlangDxcToolchainVersion>
    </PropertyGroup>

    <!--
      The toolchain SDK references the platform package of the build host and exposes SlangDxcToolchainDirectory.
      Its props read Directory.Packages.props, so this file must be imported after Microsoft.NET.Sdk's props.
    -->
    <Import Project="Sdk.props" Sdk="SlangDxcBundle.Toolchain" Version="$(SlangDxcToolchainVersion)" />

    <PropertyGroup>
        <SlangCompilerExeName>slangc</SlangCompilerExeName>
        <SlangCompilerExeName Condition="$([MSBuild]::IsOSPlatform('Windows'))">slangc.exe</SlangCompilerExeName>
        <SlangCompilerPath>$(SlangDxcToolchainDirectory)bin/$(SlangCompilerExeName)</SlangCompilerPath>
        <!-- Source imports use the build output; package imports use the task assembly beside the build directory. -->
        <SdlangCompilerAssembly Condition="Exists('$(MSBuildThisFileDirectory)..\Pixely.SdlangCompiler.csproj')">$(MSBuildThisFileDirectory)..\bin\$(Configuration)\$(TargetFramework)\Pixely.SdlangCompiler.dll</SdlangCompilerAssembly>
        <SdlangCompilerAssembly Condition="!Exists('$(MSBuildThisFileDirectory)..\Pixely.SdlangCompiler.csproj')">$(MSBuildThisFileDirectory)..\Pixely.SdlangCompiler.dll</SdlangCompilerAssembly>
    </PropertyGroup>
</Project>
