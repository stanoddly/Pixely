<Project>
    <!--
      The download variant: PackageIntegrationTests serves native.c over HTTP and passes the URLs, hashes and cache folder.
      They are declared here, after the Pixely SDK's browser targets are imported, as a package's targets would declare them.
    -->
    <PropertyGroup>
        <PixelyNativeUrlCacheDirectory Condition="'$(BrowserLoopConsumerNativeUrlCache)' != ''">$(BrowserLoopConsumerNativeUrlCache)</PixelyNativeUrlCacheDirectory>
    </PropertyGroup>
    <ItemGroup>
        <NativeUrlReference Include="$(BrowserLoopConsumerNativeUrl)" Sha256="$(BrowserLoopConsumerNativeSha256)" Condition="'$(BrowserLoopConsumerNativeUrl)' != ''" />
        <NativeUrlReference Include="$(BrowserLoopConsumerOtherNativeUrl)" Sha256="$(BrowserLoopConsumerOtherNativeSha256)" Condition="'$(BrowserLoopConsumerOtherNativeUrl)' != ''" />
    </ItemGroup>
</Project>
