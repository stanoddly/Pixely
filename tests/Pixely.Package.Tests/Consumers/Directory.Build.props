<Project>

    <!--
      The Pixely SDK compiles browser publishes with Mono AOT by default, which needs the wasm-tools workload from the first
      evaluation on. Most CI lanes run the fixtures without it, and AOT would add minutes to every browser publish, so the fixtures
      opt out as a project would.
    -->
    <PropertyGroup>
        <RunAOTCompilation Condition="'$(RunAOTCompilation)' == ''">false</RunAOTCompilation>
    </PropertyGroup>

    <!--
      The fixtures take the XDL runtime from the packed SDK only, not from tests/Directory.Build.targets. The browser fixtures never
      call SDL and most lanes cannot relink the runtime with XDL's archives, so they skip the browser native package; the tests of
      the native package set the property to false on the command line.
    -->
    <PropertyGroup>
        <_PixelyRepositoryNativeTargets>false</_PixelyRepositoryNativeTargets>
        <_PixelySkipNativePackage Condition="'$(_PixelySkipNativePackage)' == '' and '$(RuntimeIdentifier)' == 'browser-wasm'">true</_PixelySkipNativePackage>
    </PropertyGroup>

</Project>
