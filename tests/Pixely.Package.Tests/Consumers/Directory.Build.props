<Project>

    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

    <!--
      The Pixely SDK compiles browser publishes with Mono AOT by default, which needs the wasm-tools workload from the first
      evaluation on. Most CI lanes run the fixtures without it, and AOT would add minutes to every browser publish, so the fixtures
      opt out as a project would.
    -->
    <PropertyGroup>
        <RunAOTCompilation Condition="'$(RunAOTCompilation)' == ''">false</RunAOTCompilation>
    </PropertyGroup>

    <!--
      The browser fixtures never call SDL and most lanes cannot relink the runtime, so they skip PIXELY0013. The test of the error
      sets the property to false on the command line.
    -->
    <PropertyGroup>
        <_PixelySkipBrowserSdlCheck Condition="'$(_PixelySkipBrowserSdlCheck)' == ''">true</_PixelySkipBrowserSdlCheck>
    </PropertyGroup>

</Project>
