<Project Sdk="Microsoft.NET.Sdk">
    <!-- The version comes from the global.json PackageIntegrationTests writes beside this project. -->
    <Sdk Name="Pixely" />

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- A browser publish trims, so a trim warning from Pixely.Ecs fails this fixture as it fails a game that treats warnings as errors. -->
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- The fixture intentionally stays outside repository-wide central package management. -->
        <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    </PropertyGroup>

</Project>
