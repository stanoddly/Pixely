<Project Sdk="Microsoft.NET.Sdk">
    <!-- The version comes from the global.json PackageIntegrationTests writes beside this project. -->
    <Sdk Name="Pixely" />

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!-- A leftover unversioned reference; PackageIntegrationTests enables it to check that the SDK's pin wins under central package management. -->
    <ItemGroup Condition="'$(PixelyRedundantReference)' == 'true'">
        <PackageReference Include="Pixely" />
        <PackageReference Include="SlangDxcBundle.Toolchain" />
    </ItemGroup>

</Project>
