<Project Sdk="Microsoft.NET.Sdk">
    <!-- The version comes from the global.json PackageIntegrationTests writes beside this project. -->
    <Sdk Name="Pixely" />

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- The fixture intentionally stays outside repository-wide central package management. -->
        <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <!-- A leftover reference with a wrong version; PackageIntegrationTests enables it to check that the SDK's pin wins. -->
    <ItemGroup Condition="'$(PixelyRedundantReference)' == 'true'">
        <PackageReference Include="Pixely" Version="0.0.0" />
    </ItemGroup>

</Project>
