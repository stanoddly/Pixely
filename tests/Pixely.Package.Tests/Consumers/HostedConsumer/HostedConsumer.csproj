<Project Sdk="Microsoft.NET.Sdk">
    <!-- The version comes from the global.json PackageIntegrationTests writes beside this project. -->
    <Sdk Name="Pixely" />

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PixelyHosting>true</PixelyHosting>
        <!-- The fixture intentionally stays outside repository-wide central package management. -->
        <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
        <!-- The mistake PIXELY0004 reports: a browser RID in the project body, where the SDK props evaluated before it cannot see it. -->
        <RuntimeIdentifier Condition="'$(HostedConsumerBodyRuntimeIdentifier)' == 'true'">browser-wasm</RuntimeIdentifier>
        <!-- The PIXELY0015 test lists RIDs joined with +, since -p splits at a comma, and a semicolon escaped on the command line reaches NuGet's restore still escaped. -->
        <RuntimeIdentifiers Condition="'$(HostedConsumerRuntimeIdentifiers)' != ''">$([MSBuild]::Unescape($(HostedConsumerRuntimeIdentifiers.Replace('+', '%3B'))))</RuntimeIdentifiers>
    </PropertyGroup>

    <ItemGroup>
        <!-- A library on the SDK that a browser publish must leave a library. -->
        <ProjectReference Include="..\LibraryConsumer\LibraryConsumer.csproj" Condition="'$(HostedConsumerReferencesLibrary)' == 'true'" />
    </ItemGroup>

</Project>
