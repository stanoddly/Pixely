<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <!-- One version for the bindings and the native package the SDK picks per RID (Pixely.Native.targets); exact, so they never mix. -->
        <PixelyXdlSharpVersion>3.4.20.4</PixelyXdlSharpVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageVersion Include="Arch" Version="2.1.0" />
        <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
        <PackageVersion Include="coverlet.collector" Version="10.1.0" />
        <PackageVersion Include="Fluidify" Version="1.0.1" />
        <PackageVersion Include="Microsoft.Build.Framework" Version="18.11.0" />
        <PackageVersion Include="Microsoft.Build.Utilities.Core" Version="18.11.0" />
        <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
        <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.14" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
        <PackageVersion Include="NUnit" Version="5.0.0" />
        <PackageVersion Include="NUnit.Analyzers" Version="4.15.0" />
        <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
        <PackageVersion Include="XdlSharp" Version="[$(PixelyXdlSharpVersion)]" />
        <PackageVersion Include="ZLogger" Version="2.6.1" />
    </ItemGroup>
</Project>
