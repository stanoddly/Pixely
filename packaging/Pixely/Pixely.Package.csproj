<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- One lib/ folder per framework, every assembly in both: NuGet picks lib/net11.0-browser1.0/ for a net11.0-browser consumer and takes nothing from lib/net11.0/. -->
        <TargetFrameworks>net11.0;net11.0-browser</TargetFrameworks>
        <!-- Keep the packaging project's own output out of lib while retaining pack's build-output and symbol extension points. -->
        <TargetExt>.packaging</TargetExt>
        <DebugType>none</DebugType>
        <IsPackable>true</IsPackable>
        <IncludeBuildOutput>true</IncludeBuildOutput>
        <PackageId>Pixely</PackageId>
        <PackageVersion Condition="'$(PackageVersion)' == ''">0.0.0-alpha.local</PackageVersion>
        <Authors>stanoddly</Authors>
        <PackageDescription>Personal, highly experimental .NET game-development toolkit. APIs, architecture, and package boundaries may change without notice.</PackageDescription>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageTags>game-development;graphics;audio;dependency-injection;experimental</PackageTags>
        <RepositoryUrl>https://github.com/stanoddly/Pixely</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);CollectPixelyBuildOutputs</TargetsForTfmSpecificBuildOutput>
        <TargetsForTfmSpecificDebugSymbolsInPackage>$(TargetsForTfmSpecificDebugSymbolsInPackage);CollectPixelyDebugSymbols</TargetsForTfmSpecificDebugSymbolsInPackage>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);GeneratePixelyVersionProps</TargetsForTfmSpecificContentInPackage>
        <!-- The compatible-framework check compares lib/net11.0-browser/ against lib/net11.0/, so the browser build of Pixely must keep the desktop build's public surface. -->
        <EnablePackageValidation>true</EnablePackageValidation>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging" />
        <PackageReference Include="ZLogger" />
        <PackageReference Include="ppy.SDL3-CS" />
        <PackageReference Include="ppy.SDL3_image-CS" />
        <PackageReference Include="ppy.SDL3_mixer-CS" />
        <PackageReference Include="ppy.SDL3_ttf-CS" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Pixely.PathFinding\Pixely.PathFinding.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
        <ProjectReference Include="..\..\src\Pixely.Fitness\Pixely.Fitness.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
        <ProjectReference Include="..\..\src\Pixely.Audio\Pixely.Audio.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
        <ProjectReference Include="..\..\src\Pixely.Collections\Pixely.Collections.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
        <ProjectReference Include="..\..\src\Pixely.Componentize\Pixely.Componentize.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
        <ProjectReference Include="..\..\src\Pixely.Core\Pixely.Core.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
        <ProjectReference Include="..\..\src\Pixely.DependencyInjection\Pixely.DependencyInjection.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
        <ProjectReference Include="..\..\src\Pixely.Events\Pixely.Events.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
        <ProjectReference Include="..\..\src\Pixely.Logging\Pixely.Logging.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
        <ProjectReference Include="..\..\src\Pixely.Observations\Pixely.Observations.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
        <ProjectReference Include="..\..\src\Pixely.ShaderCommon\Pixely.ShaderCommon.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
        <ProjectReference Include="..\..\src\Pixely.Ui\Pixely.Ui.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
        <ProjectReference Include="..\..\src\Pixely.Utils\Pixely.Utils.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
        <ProjectReference Include="..\..\src\Pixely\Pixely.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
        <None Include="..\..\docs\*.md" Pack="true" PackagePath="docs" />
        <None Include="..\..\src\Pixely.DependencyInjection.Generator\bin\$(Configuration)\netstandard2.0\Pixely.DependencyInjection.Generator.dll"
              Pack="true" PackagePath="analyzers\dotnet\cs" />
        <None Include="..\..\src\Pixely.SdlangCompiler\bin\$(Configuration)\net11.0\Pixely.SdlangCompiler.dll"
              Pack="true" PackagePath="tools\net11.0\any" />
        <None Include="..\..\src\Pixely.ShaderCommon\bin\$(Configuration)\net11.0\Pixely.ShaderCommon.dll"
              Pack="true" PackagePath="tools\net11.0\any" />
        <None Include="..\..\src\Pixely.SdlangCompiler\build\Pixely.SdlangCompiler.props"
              Pack="true" PackagePath="tools\net11.0\any\build" />
        <None Include="..\..\src\Pixely.SdlangCompiler\build\Pixely.SdlangCompiler.targets"
              Pack="true" PackagePath="tools\net11.0\any\build" />
        <None Include="Sdk\*.props;Sdk\*.targets" Pack="true" PackagePath="Sdk" />
        <None Include="wwwroot\*" Pack="true" PackagePath="wwwroot" />
        <None Include="buildTransitive\Pixely.targets" Pack="true" PackagePath="buildTransitive" />
    </ItemGroup>

    <!-- The SDK cannot otherwise learn its own version; Sdk.targets pins the library and buildTransitive/Pixely.targets names the version in its message. Framework-independent, so one inner build packs it. -->
    <Target Name="GeneratePixelyVersionProps" Returns="@(TfmSpecificPackageFile)" Condition="'$(TargetFramework)' == 'net11.0'">
        <PropertyGroup>
            <_PixelyVersionPropsPath>$(IntermediateOutputPath)Sdk\Pixely.Version.props</_PixelyVersionPropsPath>
        </PropertyGroup>
        <ItemGroup>
            <_PixelyVersionPropsLine Include="&lt;Project&gt;" />
            <_PixelyVersionPropsLine Include="%20%20%20%20&lt;PropertyGroup&gt;" />
            <_PixelyVersionPropsLine Include="%20%20%20%20%20%20%20%20&lt;PixelyVersion&gt;$(PackageVersion)&lt;/PixelyVersion&gt;" />
            <_PixelyVersionPropsLine Include="%20%20%20%20&lt;/PropertyGroup&gt;" />
            <_PixelyVersionPropsLine Include="&lt;/Project&gt;" />
            <TfmSpecificPackageFile Include="$(_PixelyVersionPropsPath)" PackagePath="Sdk" />
        </ItemGroup>
        <WriteLinesToFile File="$(_PixelyVersionPropsPath)" Lines="@(_PixelyVersionPropsLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    </Target>

    <!--
      This inner build's TargetFramework is a global property that flows into the referenced projects: Pixely multi-targets and
      builds for it; the other projects build for net11.0 alone, so it is undefined for them and they are copied into both folders.
    -->
    <Target Name="ResolvePixelyRuntimeOutputs">
        <ItemGroup>
            <_PixelyRuntimeProject Include="@(ProjectReference)" Exclude="..\..\src\Pixely\Pixely.csproj" RemoveProperties="TargetFramework" />
            <_PixelyRuntimeProject Include="..\..\src\Pixely\Pixely.csproj" RemoveProperties="" />
        </ItemGroup>
        <MSBuild Projects="@(_PixelyRuntimeProject)"
                 Targets="GetTargetPath"
                 BuildInParallel="true"
                 RemoveProperties="%(_PixelyRuntimeProject.RemoveProperties)"
                 Properties="Configuration=$(Configuration);Version=$(Version);PackageVersion=$(PackageVersion);RepositoryCommit=$(RepositoryCommit);RepositoryBranch=$(RepositoryBranch);ContinuousIntegrationBuild=$(ContinuousIntegrationBuild)">
            <Output TaskParameter="TargetOutputs" ItemName="_PixelyRuntimeAssembly" />
        </MSBuild>
        <ItemGroup>
            <_PixelyRuntimeSymbol Include="@(_PixelyRuntimeAssembly->'%(RootDir)%(Directory)%(Filename).pdb')" />
        </ItemGroup>
    </Target>

    <Target Name="CollectPixelyBuildOutputs" DependsOnTargets="ResolvePixelyRuntimeOutputs" Returns="@(BuildOutputInPackage)">
        <ItemGroup>
            <BuildOutputInPackage Include="@(_PixelyRuntimeAssembly)">
                <FinalOutputPath>%(Identity)</FinalOutputPath>
                <TargetPath>%(Filename)%(Extension)</TargetPath>
            </BuildOutputInPackage>
        </ItemGroup>
    </Target>

    <Target Name="CollectPixelyDebugSymbols" DependsOnTargets="ResolvePixelyRuntimeOutputs" Returns="@(TfmSpecificDebugSymbolsFile)">
        <ItemGroup>
            <TfmSpecificDebugSymbolsFile Include="@(_PixelyRuntimeSymbol)">
                <FinalOutputPath>%(Identity)</FinalOutputPath>
                <TargetPath>%(Filename)%(Extension)</TargetPath>
                <TargetFramework>$(TargetFramework)</TargetFramework>
            </TfmSpecificDebugSymbolsFile>
        </ItemGroup>
    </Target>

</Project>
