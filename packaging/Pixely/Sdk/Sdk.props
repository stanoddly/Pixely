<Project>
    <Import Project="$(MSBuildThisFileDirectory)Pixely.Version.props" />

    <PropertyGroup>
        <_PixelySdkImported>true</_PixelySdkImported>
        <!-- Microsoft.NET.Sdk must come first: its props import the restored packages' props and Directory.Packages.props, which this file reads. -->
        <_PixelyBaseSdkFirst>$(UsingMicrosoftNETSdk)</_PixelyBaseSdkFirst>
        <InterceptorsNamespaces>$(InterceptorsNamespaces);Pixely.DependencyInjection.Generated</InterceptorsNamespaces>
        <PixelyDocsDirectory>$(MSBuildThisFileDirectory)..\docs\</PixelyDocsDirectory>
    </PropertyGroup>

    <ItemGroup>
        <CompilerVisibleProperty Include="PixelyDIEmitTrimAnnotations" />
    </ItemGroup>

    <!-- SlangVersion pins the toolchain for package consumers here and for source builds in the same file. -->
    <Import Project="$(MSBuildThisFileDirectory)..\tools\net11.0\any\build\Pixely.SdlangCompiler.props" />
    <Import Project="$(MSBuildThisFileDirectory)Pixely.Browser.props" />
</Project>
