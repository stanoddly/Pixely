<Project>
    <!--
      XDL's runtime comes from one XdlSharp.Native.<rid> package per platform. A project restores only the one it runs on: the RID it
      builds or publishes for, or the build host's portable RID for a RID-less build, such as a local run or debugging session.
      Every project gets it, libraries included: the restore evaluation of a test project imports no package props, so it still
      sees the OutputType Library that Microsoft.NET.Test.Sdk later turns into Exe. PrivateAssets keeps the package out of a packed
      library's dependencies, and a library's RID-agnostic reference build has no RuntimeIdentifier for PIXELY0015 to check.
      The .NET SDK reads PrivateAssets="all" as Publish="false" unless Publish is set, so without Publish="true" a publish would
      leave the native libraries out.
      Evaluated after the project body, so a RuntimeIdentifier set there counts. Consumers get this file from Sdk.targets; repository tests and
      tutorials import it from their Directory.Build.targets. _PixelySkipNativePackage is for the SDK's own browser fixtures,
      which cannot relink the runtime; it is not a supported setting.
    -->
    <PropertyGroup>
        <_PixelyNativeApplies>false</_PixelyNativeApplies>
        <_PixelyNativeApplies Condition="'$(_PixelySkipNativePackage)' != 'true'">true</_PixelyNativeApplies>
        <_PixelyNativeRuntimeIdentifier>$(RuntimeIdentifier)</_PixelyNativeRuntimeIdentifier>
        <_PixelyNativeRuntimeIdentifier Condition="'$(_PixelyNativeRuntimeIdentifier)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</_PixelyNativeRuntimeIdentifier>
        <_PixelyNativeSupportedRuntimeIdentifiers>linux-x64;linux-arm64;osx-x64;osx-arm64;win-x64;win-arm64;browser-wasm</_PixelyNativeSupportedRuntimeIdentifiers>
        <_PixelyNativeRuntimeIdentifierSupported>false</_PixelyNativeRuntimeIdentifierSupported>
        <_PixelyNativeRuntimeIdentifierSupported Condition="$([System.String]::Copy(';$(_PixelyNativeSupportedRuntimeIdentifiers);').Contains(';$(_PixelyNativeRuntimeIdentifier);'))">true</_PixelyNativeRuntimeIdentifierSupported>
        <_PixelyNativePackageId>XdlSharp.Native.$(_PixelyNativeRuntimeIdentifier)</_PixelyNativePackageId>
    </PropertyGroup>

    <!-- Implicit with its own version, as the SDK's reference to Pixely, so central package management needs no entry for it. -->
    <ItemGroup Condition="'$(_PixelyNativeApplies)' == 'true' and '$(_PixelyNativeRuntimeIdentifierSupported)' == 'true'">
        <PackageReference Include="$(_PixelyNativePackageId)" Version="[$(PixelyXdlSharpVersion)]" PrivateAssets="all" Publish="true" IsImplicitlyDefined="true" />
    </ItemGroup>

    <Target Name="_PixelyRequireSupportedNativeRuntimeIdentifier" BeforeTargets="CollectPackageReferences;BeforeBuild"
            Condition="'$(_PixelyNativeApplies)' == 'true' and '$(_PixelyNativeRuntimeIdentifierSupported)' != 'true'">
        <Error Code="PIXELY0014" File="$(MSBuildProjectFullPath)" Text="XDL has no native libraries for the runtime identifier '$(_PixelyNativeRuntimeIdentifier)'. Supported: $(_PixelyNativeSupportedRuntimeIdentifiers.Replace(';', ', '))." />
    </Target>

    <!--
      A restore keeps the native package of the RID it saw. A restore with RuntimeIdentifiers and no -r writes a target for each
      listed RID but restores only the host's native package, so a later build or publish with -r and no restore would ship
      without XDL. The assets file lists every restored package under "libraries" as "<id>/<version>".
    -->
    <Target Name="_PixelyRequireRestoredNativePackage" BeforeTargets="ResolvePackageAssets"
            Condition="'$(_PixelyNativeApplies)' == 'true' and '$(_PixelyNativeRuntimeIdentifierSupported)' == 'true' and '$(RuntimeIdentifier)' != '' and Exists('$(ProjectAssetsFile)')">
        <PropertyGroup>
            <_PixelyNativePackageRestored>$([System.IO.File]::ReadAllText('$(ProjectAssetsFile)').ToLowerInvariant().Contains('"$(_PixelyNativePackageId.ToLowerInvariant())/'))</_PixelyNativePackageRestored>
        </PropertyGroup>
        <Error Code="PIXELY0015" File="$(MSBuildProjectFullPath)" Condition="'$(_PixelyNativePackageRestored)' != 'true'"
               Text="The restore did not include $(_PixelyNativePackageId), the XDL runtime for '$(RuntimeIdentifier)'. Restore with -r $(RuntimeIdentifier), or build without --no-restore." />
    </Target>
</Project>
