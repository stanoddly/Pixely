<Project>

    <!--
      Generates the entry point for a project that sets PixelyHosting=true: a partial Program in the
      project's RootNamespace whose Main builds the app from the project's Configure, runs it and
      hands a failure to the project's OnException, plus a default OnException as an extension member
      of Program. On browser-wasm the browser owns the frame loop and the WebGPU device is requested
      asynchronously, so Main is async, awaits Pixely.App.BrowserHost.PrepareAsync before building and
      Pixely.App.BrowserHost.RunAsync in place of app.Run(), and reports the failure to the page through
      Pixely.App.BrowserHost.ReportExceptionAsync; every other line is shared. An exception OnException
      throws leaves Main in an AggregateException with the failure it was handling, unless it is that
      failure or holds it as its inner exception. Consumers get this file through the Pixely SDK
      (Sdk/Pixely.AfterSdk.targets); repository tutorials register it on AfterMicrosoftNETSdkTargets
      from tutorials/Directory.Build.targets. Both import points come after the base SDK has set
      IntermediateOutputPath, Language and RootNamespace, which an import from a project body does not.
    -->

    <PropertyGroup>
        <_PixelyEntryPointFile>$(IntermediateOutputPath)PixelyProgram.g.cs</_PixelyEntryPointFile>
        <_PixelyGenerateEntryPoint>false</_PixelyGenerateEntryPoint>
        <_PixelyGenerateEntryPoint Condition="'$(PixelyHosting)' == 'true' and ('$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe') and '$(Language)' == 'C#' and '$(RootNamespace)' != ''">true</_PixelyGenerateEntryPoint>
    </PropertyGroup>

    <!-- Declared at evaluation time so the file is part of @(Compile) whether or not the writing target runs. -->
    <ItemGroup Condition="'$(_PixelyGenerateEntryPoint)' == 'true'">
        <Compile Include="$(_PixelyEntryPointFile)" Link="Properties\PixelyProgram.g.cs" />
        <FileWrites Include="$(_PixelyEntryPointFile)" />
    </ItemGroup>

    <!-- No Inputs/Outputs: WriteOnlyWhenDifferent keeps the timestamp stable and the target is cheap. -->
    <Target Name="GeneratePixelyEntryPoint" BeforeTargets="CoreCompile" Condition="'$(_PixelyGenerateEntryPoint)' == 'true'">
        <!--
          One item per line. MSBuild trims an Include and rejects an empty one, so indentation is
          written as %20 and a blank line as %0A on the end of the line before it; a literal
          semicolon would split the item, so it is %3B, and a literal question mark would be a
          wildcard, so it is %3F.
        -->
        <ItemGroup>
            <_PixelyEntryPointLine Include="// &lt;auto-generated/&gt;" />
            <_PixelyEntryPointLine Include="#nullable enable" />
            <_PixelyEntryPointLine Include="namespace $(RootNamespace)%3B%0A" />
            <_PixelyEntryPointLine Include="static partial class Program" />
            <_PixelyEntryPointLine Include="{" />
            <_PixelyEntryPointLine Include="%20%20%20%20private static int Main()" Condition="'$(_PixelyBrowser)' != 'true'" />
            <!-- CA1416 flags an unguarded call to a browser-only method whatever the SupportedPlatform set is; the attribute on Main is what satisfies it. -->
            <_PixelyEntryPointLine Include="%20%20%20%20[global::System.Runtime.Versioning.SupportedOSPlatform(&quot;browser&quot;)]" Condition="'$(_PixelyBrowser)' == 'true'" />
            <_PixelyEntryPointLine Include="%20%20%20%20private static async global::System.Threading.Tasks.Task&lt;int&gt; Main()" Condition="'$(_PixelyBrowser)' == 'true'" />
            <_PixelyEntryPointLine Include="%20%20%20%20{" />
            <_PixelyEntryPointLine Include="%20%20%20%20%20%20%20%20global::Pixely.App.PixelyAppBuilder builder = new()%3B" />
            <_PixelyEntryPointLine Include="%20%20%20%20%20%20%20%20global::Pixely.App.IPixelyApp%3F app = null%3B" />
            <_PixelyEntryPointLine Include="%20%20%20%20%20%20%20%20try" />
            <_PixelyEntryPointLine Include="%20%20%20%20%20%20%20%20{" />
            <_PixelyEntryPointLine Include="%20%20%20%20%20%20%20%20%20%20%20%20Program.Configure(builder)%3B" />
            <_PixelyEntryPointLine Include="%20%20%20%20%20%20%20%20%20%20%20%20await global::Pixely.App.BrowserHost.PrepareAsync(builder)%3B" Condition="'$(_PixelyBrowser)' == 'true'" />
            <_PixelyEntryPointLine Include="%20%20%20%20%20%20%20%20%20%20%20%20app = builder.Build()%3B" />
            <_PixelyEntryPointLine Include="%20%20%20%20%20%20%20%20%20%20%20%20return app.Run()%3B" Condition="'$(_PixelyBrowser)' != 'true'" />
            <_PixelyEntryPointLine Include="%20%20%20%20%20%20%20%20%20%20%20%20return await global::Pixely.App.BrowserHost.RunAsync(app)%3B" Condition="'$(_PixelyBrowser)' == 'true'" />
            <_PixelyEntryPointLine Include="%20%20%20%20%20%20%20%20}" />
            <_PixelyEntryPointLine Include="%20%20%20%20%20%20%20%20catch (global::System.Exception exception)" />
            <_PixelyEntryPointLine Include="%20%20%20%20%20%20%20%20{" />
            <_PixelyEntryPointLine Include="%20%20%20%20%20%20%20%20%20%20%20%20// The page shows the type and message of the exception that ended the app, and a managed exception loses the type on its way to JavaScript." Condition="'$(_PixelyBrowser)' == 'true'" />
            <_PixelyEntryPointLine Include="%20%20%20%20%20%20%20%20%20%20%20%20await global::Pixely.App.BrowserHost.ReportExceptionAsync(exception)%3B" Condition="'$(_PixelyBrowser)' == 'true'" />
            <_PixelyEntryPointLine Include="%20%20%20%20%20%20%20%20%20%20%20%20try" />
            <_PixelyEntryPointLine Include="%20%20%20%20%20%20%20%20%20%20%20%20{" />
            <_PixelyEntryPointLine Include="%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20// Handled before the finally disposes the app, so a failure during Run still has its window open. Invoked rather than passed as a method group: an invocation binds to a declared OnException whatever it returns, so a wrong return type is a compile error instead of a silent fall-through to the default." />
            <_PixelyEntryPointLine Include="%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20return Program.OnException(exception)%3B" />
            <_PixelyEntryPointLine Include="%20%20%20%20%20%20%20%20%20%20%20%20}" />
            <_PixelyEntryPointLine Include="%20%20%20%20%20%20%20%20%20%20%20%20// An exception OnException throws while handling the failure would hide it, so both leave Main. The default OnException rethrows the exception it was given, and a handler may wrap it as the inner exception%3B either leaves as it is." />
            <_PixelyEntryPointLine Include="%20%20%20%20%20%20%20%20%20%20%20%20catch (global::System.Exception handlerException) when (!global::System.Object.ReferenceEquals(handlerException, exception) &amp;&amp; !global::System.Object.ReferenceEquals(handlerException.InnerException, exception))" />
            <_PixelyEntryPointLine Include="%20%20%20%20%20%20%20%20%20%20%20%20{" />
            <_PixelyEntryPointLine Include="%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20global::System.AggregateException failure = new(&quot;OnException threw while handling an exception.&quot;, exception, handlerException)%3B" />
            <_PixelyEntryPointLine Include="%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20await global::Pixely.App.BrowserHost.ReportExceptionAsync(failure)%3B" Condition="'$(_PixelyBrowser)' == 'true'" />
            <_PixelyEntryPointLine Include="%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20throw failure%3B" />
            <_PixelyEntryPointLine Include="%20%20%20%20%20%20%20%20%20%20%20%20}" />
            <_PixelyEntryPointLine Include="%20%20%20%20%20%20%20%20%20%20%20%20// A handler that wraps the failure replaces it on purpose, so the page shows the wrapper." Condition="'$(_PixelyBrowser)' == 'true'" />
            <_PixelyEntryPointLine Include="%20%20%20%20%20%20%20%20%20%20%20%20catch (global::System.Exception handlerException) when (global::System.Object.ReferenceEquals(handlerException.InnerException, exception))" Condition="'$(_PixelyBrowser)' == 'true'" />
            <_PixelyEntryPointLine Include="%20%20%20%20%20%20%20%20%20%20%20%20{" Condition="'$(_PixelyBrowser)' == 'true'" />
            <_PixelyEntryPointLine Include="%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20await global::Pixely.App.BrowserHost.ReportExceptionAsync(handlerException)%3B" Condition="'$(_PixelyBrowser)' == 'true'" />
            <_PixelyEntryPointLine Include="%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20throw%3B" Condition="'$(_PixelyBrowser)' == 'true'" />
            <_PixelyEntryPointLine Include="%20%20%20%20%20%20%20%20%20%20%20%20}" Condition="'$(_PixelyBrowser)' == 'true'" />
            <_PixelyEntryPointLine Include="%20%20%20%20%20%20%20%20}" />
            <_PixelyEntryPointLine Include="%20%20%20%20%20%20%20%20finally" />
            <_PixelyEntryPointLine Include="%20%20%20%20%20%20%20%20{" />
            <_PixelyEntryPointLine Include="%20%20%20%20%20%20%20%20%20%20%20%20app%3F.Dispose()%3B" />
            <_PixelyEntryPointLine Include="%20%20%20%20%20%20%20%20}" />
            <_PixelyEntryPointLine Include="%20%20%20%20}" />
            <_PixelyEntryPointLine Include="}%0A" />
            <_PixelyEntryPointLine Include="// Lookup prefers a member Program declares over an extension member, so the OnException below applies only when the project declares none." />
            <_PixelyEntryPointLine Include="static class PixelyProgramDefaults" />
            <_PixelyEntryPointLine Include="{" />
            <_PixelyEntryPointLine Include="%20%20%20%20extension(Program)" />
            <_PixelyEntryPointLine Include="%20%20%20%20{" />
            <_PixelyEntryPointLine Include="%20%20%20%20%20%20%20%20// Rethrown with its original stack trace, so a failure fails the process as it would from a hand-written Main." />
            <_PixelyEntryPointLine Include="%20%20%20%20%20%20%20%20internal static int OnException(global::System.Exception exception)" />
            <_PixelyEntryPointLine Include="%20%20%20%20%20%20%20%20{" />
            <_PixelyEntryPointLine Include="%20%20%20%20%20%20%20%20%20%20%20%20global::System.Runtime.ExceptionServices.ExceptionDispatchInfo.Throw(exception)%3B" />
            <_PixelyEntryPointLine Include="%20%20%20%20%20%20%20%20%20%20%20%20return 1%3B" />
            <_PixelyEntryPointLine Include="%20%20%20%20%20%20%20%20}" />
            <_PixelyEntryPointLine Include="%20%20%20%20}" />
            <_PixelyEntryPointLine Include="}" />
        </ItemGroup>
        <WriteLinesToFile File="$(_PixelyEntryPointFile)" Lines="@(_PixelyEntryPointLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    </Target>

</Project>
