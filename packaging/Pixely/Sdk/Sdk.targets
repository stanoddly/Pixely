<Project>
    <!--
      The library follows the SDK version exactly. The toolchain is a build-host tool of this project, so it stays
      out of the nuspec of a library built on Pixely; its consumers add the Sdk line themselves when they compile shaders.
      This file is evaluated after the project body, so a reference or central pin the project declares for either
      package is replaced here rather than overriding the SDK's (the .NET SDK keeps an explicit reference over an
      implicit one). Implicit references carry their own version under central package management (NU1008 exempts
      them, NU1009 forbids a PackageVersion for them).
    -->
    <ItemGroup>
        <_PixelyOtherPackageReference Include="@(PackageReference)" />
        <_PixelyOtherPackageReference Remove="Pixely;SlangDxcBundle.Toolchain" />
        <_PixelyRedundantPackageReference Include="@(PackageReference)" Exclude="@(_PixelyOtherPackageReference)" />
        <PackageReference Remove="Pixely;SlangDxcBundle.Toolchain" />
        <PackageVersion Remove="Pixely;SlangDxcBundle.Toolchain" />
        <PackageReference Include="Pixely" Version="[$(PixelyVersion)]" IsImplicitlyDefined="true" />
        <PackageReference Include="SlangDxcBundle.Toolchain" Version="[$(SlangVersion)]" PrivateAssets="all" IsImplicitlyDefined="true" />
    </ItemGroup>

    <Target Name="_PixelyWarnOnRedundantPackageReference" BeforeTargets="BeforeBuild" Condition="'@(_PixelyRedundantPackageReference)' != ''">
        <Warning Code="PIXELY0001" Text="The Pixely SDK declares the package reference to @(_PixelyRedundantPackageReference, ' and to '); the project's own reference was ignored. Remove it." />
    </Target>

    <!--
      Additive SDK targets are imported after Microsoft.NET.Sdk.targets, which alone sets TargetFrameworkIdentifier.
      Import directly when it is set; otherwise defer to the hook the base SDK imports as its last line.
    -->
    <Import Project="$(MSBuildThisFileDirectory)Pixely.AfterSdk.targets" Condition="'$(TargetFrameworkIdentifier)' != ''" />
    <PropertyGroup Condition="'$(TargetFrameworkIdentifier)' == ''">
        <AfterMicrosoftNETSdkTargets>$(AfterMicrosoftNETSdkTargets);$(MSBuildThisFileDirectory)Pixely.AfterSdk.targets</AfterMicrosoftNETSdkTargets>
    </PropertyGroup>
</Project>
