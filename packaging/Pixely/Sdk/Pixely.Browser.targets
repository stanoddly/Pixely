<Project>
    <!--
      Imported on BeforeMicrosoftNETSdkTargets, the one slot after the project body and before the base targets, which
      is where a body property can still be replaced before Microsoft.NET.RuntimeIdentifierInference.targets and the
      ILCompiler import read it. PublishAot fails framework reference resolution on browser-wasm, and the WebAssembly
      pack's props stop appending the RID to the output paths, which would make desktop and browser share obj/ and bin/.
    -->
    <!--
      Only an executable is a browser app. A library evaluated with the RID (a solution-wide publish, or the restore of
      a referenced project) has already imported the WebAssembly props, which force SelfContained and PublishTrimmed;
      without this its restore would add the WebAssembly pack, whose props then default the RID and set OutputType to
      exe in every later evaluation, including the RID-agnostic reference build, and the library fails with CS5001.
      UsingMicrosoftNETSdkWebAssembly is a ProcessFrameworkReferences parameter read at execution, so clearing it here
      keeps the pack out of the graph; the two publish properties are reset so the library's restore pulls neither
      the Mono browser runtime pack nor ILLink and its publish is a plain library publish.
    -->
    <PropertyGroup Condition="'$(_PixelyBrowser)' == 'true' and '$(OutputType)' != 'Exe' and '$(OutputType)' != 'WinExe'">
        <_PixelyBrowser>false</_PixelyBrowser>
        <UsingMicrosoftNETSdkWebAssembly>false</UsingMicrosoftNETSdkWebAssembly>
        <SelfContained>false</SelfContained>
        <PublishTrimmed>false</PublishTrimmed>
    </PropertyGroup>

    <!--
      The browser build of Pixely is lib/net11.0-browser1.0/, which NuGet hands only to a net11.0-browser project, so a browser
      app targets net11.0-browser. A single-framework net11.0 project is switched here, after its body: it keeps one
      TargetFramework line for both hosts, restore reads the switched value, and the outputs land under net11.0-browser/.
      Only the targets see the switch; the project body and every props file evaluated with net11.0, so a body condition
      on TargetFramework does not see a browser publish (condition on RuntimeIdentifier or _PixelyBrowser instead). A
      multi-targeting project is not switched: its browser inner build passes, and any other inner build under the browser
      RID is PIXELY0007, which names the publish command that selects the browser framework. The check reads the platform the
      base targets inferred, so net11.0-browser1.0, the same framework with its platform version, passes too.
    -->
    <PropertyGroup Condition="'$(_PixelyBrowser)' == 'true' and '$(TargetFrameworks)' == '' and '$(TargetFramework)' == 'net11.0'">
        <TargetFramework>net11.0-browser</TargetFramework>
    </PropertyGroup>

    <PropertyGroup Condition="'$(_PixelyBrowser)' == 'true'">
        <PublishAot>false</PublishAot>
        <SelfContained>true</SelfContained>
        <PublishTrimmed>true</PublishTrimmed>
        <AppendRuntimeIdentifierToOutputPath>true</AppendRuntimeIdentifierToOutputPath>
        <PixelyBrowserDefaultAssets Condition="'$(PixelyBrowserDefaultAssets)' == ''">true</PixelyBrowserDefaultAssets>
        <PixelyBrowserIndexHtml Condition="'$(PixelyBrowserIndexHtml)' == ''">$(MSBuildThisFileDirectory)..\wwwroot\index.html</PixelyBrowserIndexHtml>
        <PixelyBrowserMainJs Condition="'$(PixelyBrowserMainJs)' == ''">$(MSBuildThisFileDirectory)..\wwwroot\main.js</PixelyBrowserMainJs>
        <_PixelyBrowserHostJs>$(MSBuildThisFileDirectory)..\wwwroot\pixely-host.js</_PixelyBrowserHostJs>
    </PropertyGroup>

    <!--
      SDL's Emscripten backend assigns Module['requestFullscreen'] in SDL_CreateWindow. A relink with assertions (the Debug
      -O0 link) defines every unexported runtime symbol on Module as a getter-only property, and the assignment throws
      "Cannot set property requestFullscreen of #<Object> which has only a getter" in the SDK's strict ES6 output. Exporting
      the symbol makes the runtime install it as a plain property that SDL then overwrites. Takes effect only when the runtime
      is relinked (native references, or a Release publish with the wasm-tools workload installed); reported to SDL, to be
      dropped once SDL_emscriptenvideo.c defines the property itself.
    -->
    <ItemGroup Condition="'$(_PixelyBrowser)' == 'true'">
        <EmccExportedRuntimeMethod Include="requestFullscreen" />
    </ItemGroup>

    <!--
      SDL's WebGPU backend (stanoddly/SDL_wgpu) is implemented on emdawnwebgpu, the WebGPU binding Emscripten ships as a remote
      port: its archive, its JavaScript libraries, and the entry points pixely-host.js uses to hand the page's adapter and device
      to SDL. The port is fetched and built at link time, which the workload's frozen cache cannot hold, so WasmCachePath has to
      name a writable copy of it (docs/hosting.md). Opt in with PixelyBrowserWebGpu=true alongside an SDL3.a built with the backend.
    -->
    <PropertyGroup Condition="'$(_PixelyBrowser)' == 'true' and '$(PixelyBrowserWebGpu)' == 'true'">
        <EmccExtraLDFlags>$(EmccExtraLDFlags) --use-port=emdawnwebgpu</EmccExtraLDFlags>
    </PropertyGroup>

    <ItemGroup Condition="'$(_PixelyBrowser)' == 'true' and '$(PixelyBrowserWebGpu)' == 'true'">
        <EmccExportedRuntimeMethod Include="WebGPU" />
        <EmccExportedFunction Include="_wgpuCreateInstance" />
    </ItemGroup>

    <Target Name="_PixelyRequireWritableWasmCache" BeforeTargets="BeforeBuild"
            Condition="'$(_PixelyBrowser)' == 'true' and '$(PixelyBrowserWebGpu)' == 'true' and ('$(WasmCachePath)' == '' or '$(WasmCachePath)' == '$(EmscriptenCacheSdkCacheDir)')">
        <Error Code="PIXELY0006" File="$(MSBuildProjectFullPath)" Text="PixelyBrowserWebGpu builds the emdawnwebgpu port at link time, which needs a writable Emscripten cache: set WasmCachePath to a writable copy of the workload's cache (docs/hosting.md, WebGPU in the browser)." />
    </Target>

    <!--
      The wasm build keys its P/Invoke table by the native reference's file name and matches DllImport names literally, so
      libSDL3.a registers a module libSDL3 that nothing imports and SDL fails at run time with DllNotFoundException.
    -->
    <Target Name="_PixelyWarnOnLibPrefixedSdlArchive" BeforeTargets="BeforeBuild" DependsOnTargets="_PixelyResolveNativeUrlReferences" Condition="'$(_PixelyBrowser)' == 'true'">
        <ItemGroup>
            <_PixelyLibPrefixedSdlArchive Include="@(NativeFileReference)" Condition="$([System.String]::Copy('%(Filename)').StartsWith('libSDL3'))" />
        </ItemGroup>
        <Warning Code="PIXELY0005" File="$(MSBuildProjectFullPath)" Condition="'@(_PixelyLibPrefixedSdlArchive)' != ''"
                 Text="The native reference @(_PixelyLibPrefixedSdlArchive->'%(Filename)%(Extension)', ', ') registers a P/Invoke module named after its file; Pixely imports SDL3, SDL3_image, SDL3_ttf and SDL3_mixer, so name the archive without the lib prefix (SDL3.a)." />
    </Target>

    <!--
      A NativeUrlReference is a native reference downloaded from a URL and pinned by its SHA-256 (Sha256 metadata). The cache
      is in the project's obj folder by default, so no other project's build writes to it. It is keyed by the hash and keeps
      the URL's file name, which is the P/Invoke module the archive registers. The items become native references in a
      target, so an item declared in Directory.Build.targets or a package's targets counts too. The target runs before the
      WebAssembly targets choose to relink from the count of NativeFileReference items, also in the nested publish build,
      which does not run BeforeBuild. URL references come first on the link line: of two archives defining one symbol the
      first wins, so libXDL_wgpu.a as a URL reference replaces the GPU functions of an SDL3.a that stays a file.

      Downloads to a unique partial file beside the cached one, so a file at the cached path is always complete and verified.
      A failed task deletes every partial file of the build. The cache folder is resolved here, so PixelyNativeUrlCacheDirectory
      set in Directory.Build.targets counts too, and a URL declared twice is downloaded once.
    -->
    <Target Name="_PixelyResolveNativeUrlReferences" BeforeTargets="BeforeBuild;_SetWasmBuildNativeDefaults;_CoreCLRSetWasmBuildNativeDefaults"
            Condition="'$(_PixelyBrowser)' == 'true' and '@(NativeUrlReference)' != ''">
        <Error Code="PIXELY0008" File="$(MSBuildProjectFullPath)" Condition="'%(NativeUrlReference.Sha256)' == ''"
               Text="NativeUrlReference %(NativeUrlReference.Identity) has no Sha256 metadata; add Sha256=&quot;&lt;hex SHA-256 of the file&gt;&quot;." />
        <PropertyGroup>
            <PixelyNativeUrlCacheDirectory Condition="'$(PixelyNativeUrlCacheDirectory)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', 'native-url-cache'))</PixelyNativeUrlCacheDirectory>
            <_PixelyNativeUrlCacheDirectory>$([MSBuild]::EnsureTrailingSlash('$(PixelyNativeUrlCacheDirectory)'))</_PixelyNativeUrlCacheDirectory>
        </PropertyGroup>
        <ItemGroup>
            <_PixelyNativeUrlDownload Include="@(NativeUrlReference->Distinct())" Url="%(Identity)" CacheDirectory="$(_PixelyNativeUrlCacheDirectory)%(Sha256)/"
                                      CachedFile="$(_PixelyNativeUrlCacheDirectory)%(Sha256)/%(Filename)%(Extension)" PartialFileName="%(Filename)%(Extension).$([System.Guid]::NewGuid().ToString('N')).partial" />
            <_PixelyNativeUrlDownload Remove="@(_PixelyNativeUrlDownload)" Condition="Exists('%(CachedFile)')" />
        </ItemGroup>
        <DownloadFile SourceUrl="%(_PixelyNativeUrlDownload.Url)" DestinationFolder="%(_PixelyNativeUrlDownload.CacheDirectory)" DestinationFileName="%(_PixelyNativeUrlDownload.PartialFileName)" Retries="2"
                      Condition="'@(_PixelyNativeUrlDownload)' != ''" />
        <GetFileHash Files="@(_PixelyNativeUrlDownload->'%(CacheDirectory)%(PartialFileName)')" Algorithm="SHA256" Condition="'@(_PixelyNativeUrlDownload)' != ''">
            <Output TaskParameter="Items" ItemName="_PixelyNativeUrlDownloaded" />
        </GetFileHash>
        <ItemGroup>
            <_PixelyNativeUrlMismatch Include="@(_PixelyNativeUrlDownloaded)" Condition="'%(FileHash)' != '%(Sha256)'" />
        </ItemGroup>
        <Error Code="PIXELY0009" File="$(MSBuildProjectFullPath)" Condition="'@(_PixelyNativeUrlMismatch)' != ''"
               Text="@(_PixelyNativeUrlMismatch->'NativeUrlReference %(Url) has SHA-256 %(FileHash), not the %(Sha256) its Sha256 metadata names', '; '); every download of this build was discarded." />
        <Move SourceFiles="@(_PixelyNativeUrlDownloaded)" DestinationFiles="@(_PixelyNativeUrlDownloaded->'%(CachedFile)')" />
        <ItemGroup>
            <_PixelyNativeFileReference Include="@(NativeFileReference)" />
            <NativeFileReference Remove="@(NativeFileReference)" />
            <NativeFileReference Include="@(NativeUrlReference->Distinct()->'$(_PixelyNativeUrlCacheDirectory)%(Sha256)/%(Filename)%(Extension)')" />
            <NativeFileReference Include="@(_PixelyNativeFileReference)" />
            <_PixelyNativeFileReference Remove="@(_PixelyNativeFileReference)" />
        </ItemGroup>
        <OnError ExecuteTargets="_PixelyDeleteNativeUrlPartialFiles" />
    </Target>

    <Target Name="_PixelyDeleteNativeUrlPartialFiles">
        <Delete Files="@(_PixelyNativeUrlDownload->'%(CacheDirectory)%(PartialFileName)')" />
    </Target>

    <Target Name="_PixelyRequireBrowserTargetFramework" BeforeTargets="BeforeBuild" Condition="'$(_PixelyBrowser)' == 'true' and '$(TargetPlatformIdentifier)' != 'browser'">
        <Error Code="PIXELY0007" File="$(MSBuildProjectFullPath)" Text="A browser app targets net11.0-browser; this build targets $(TargetFramework). The Pixely SDK selects net11.0-browser for a project with the single TargetFramework net11.0 and no -f. A project with TargetFrameworks lists net11.0-browser and publishes with dotnet publish -f net11.0-browser -r browser-wasm." />
    </Target>

    <!-- The RID was set in the project body, which the SDK props evaluated before it cannot see; the WebAssembly SDK was not imported. -->
    <Target Name="_PixelyRequireBrowserSdk" BeforeTargets="BeforeBuild" Condition="'$(RuntimeIdentifier)' == 'browser-wasm' and '$(UsingMicrosoftNETSdkWebAssembly)' == ''">
        <Error Code="PIXELY0004" File="$(MSBuildProjectFullPath)" Text="RuntimeIdentifier browser-wasm must be a global property so the Pixely SDK can import the WebAssembly SDK: pass -r browser-wasm on the command line, not in the project file." />
    </Target>

    <!--
      The default page, its bootstrap and the frame loop, as static web assets of the project, each only when the
      project has no wwwroot file at that relative path (two assets with one path fail manifest generation; a linked
      or generated file at that path needs PixelyBrowserDefaultAssets=false). Copied into obj/ first so two projects
      on one SDK do not share an asset identity. The recipe is the WebAssembly SDK's own hot-reload injection.
    -->
    <Target Name="_PixelyDefineBrowserDefaultAssets" BeforeTargets="ResolveProjectStaticWebAssets" AfterTargets="ResolveStaticWebAssetsConfiguration"
            Condition="'$(_PixelyBrowser)' == 'true' and '$(PixelyBrowserDefaultAssets)' == 'true'">
        <PropertyGroup>
            <_PixelyBrowserAssetsRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'pixely-browser'))</_PixelyBrowserAssetsRoot>
        </PropertyGroup>
        <ItemGroup>
            <_PixelyBrowserDefaultAssetSource Include="$(PixelyBrowserIndexHtml)" RelativePath="index.html" />
            <_PixelyBrowserDefaultAssetSource Include="$(PixelyBrowserMainJs)" RelativePath="main.js" />
            <_PixelyBrowserDefaultAssetSource Include="$(_PixelyBrowserHostJs)" RelativePath="pixely-host.js" />
            <_PixelyBrowserDefaultAssetSource Remove="@(_PixelyBrowserDefaultAssetSource)" Condition="Exists('$(MSBuildProjectDirectory)/wwwroot/%(RelativePath)')" />
        </ItemGroup>
        <Copy SourceFiles="@(_PixelyBrowserDefaultAssetSource)" DestinationFiles="@(_PixelyBrowserDefaultAssetSource->'$(_PixelyBrowserAssetsRoot)%(RelativePath)')" SkipUnchangedFiles="true" />
        <ItemGroup>
            <_PixelyBrowserDefaultAsset Include="@(_PixelyBrowserDefaultAssetSource->'$(_PixelyBrowserAssetsRoot)%(RelativePath)')" />
            <_PixelyBrowserDefaultAsset Update="@(_PixelyBrowserDefaultAsset)" OriginalItemSpec="%(Identity)" />
            <FileWrites Include="@(_PixelyBrowserDefaultAsset)" />
        </ItemGroup>
        <DefineStaticWebAssets CandidateAssets="@(_PixelyBrowserDefaultAsset)" FingerprintCandidates="$(StaticWebAssetsFingerprintContent)" FingerprintPatterns="@(StaticWebAssetFingerprintPattern)"
                               SourceId="$(PackageId)" SourceType="Computed" ContentRoot="$(_PixelyBrowserAssetsRoot)" BasePath="$(StaticWebAssetBasePath)" AssetKind="All"
                               Condition="'@(_PixelyBrowserDefaultAsset)' != ''">
            <Output TaskParameter="Assets" ItemName="StaticWebAsset" />
            <Output TaskParameter="Assets" ItemName="_PixelyBrowserDefaultStaticWebAsset" />
        </DefineStaticWebAssets>
        <DefineStaticWebAssetEndpoints CandidateAssets="@(_PixelyBrowserDefaultStaticWebAsset)" ContentTypeMappings="@(StaticWebAssetContentTypeMapping)" Condition="'@(_PixelyBrowserDefaultAsset)' != ''">
            <Output TaskParameter="Endpoints" ItemName="StaticWebAssetEndpoint" />
        </DefineStaticWebAssetEndpoints>
    </Target>

    <!--
      The publish's boot config carries extensions.pixely, which pixely-host.js reads when main.js passes it the config: brotli is
      PixelyBrowserBrotli, when the publish writes .br files (CompressionEnabled and brotli in PublishCompressionFormats). A build
      writes none and gets no extension, so the loader stays off there. Every publish writes the file, only when its content changes,
      so turning the property off also makes the incremental boot config target run again.
    -->
    <Target Name="_PixelyAddBrowserBootConfigExtension" BeforeTargets="GeneratePublishWasmBootJson" Condition="'$(_PixelyBrowser)' == 'true'">
        <PropertyGroup>
            <_PixelyBrowserBootConfigExtension>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'pixely-boot-config.json'))</_PixelyBrowserBootConfigExtension>
            <_PixelyPublishCompressionFormats>;$(PublishCompressionFormats.Replace(' ', '').ToLowerInvariant());</_PixelyPublishCompressionFormats>
            <_PixelyPublishWritesBrotli>false</_PixelyPublishWritesBrotli>
            <_PixelyPublishWritesBrotli Condition="'$(CompressionEnabled)' == 'true' and '$(_PixelyPublishCompressionFormats.Contains(`;brotli;`))' == 'true'">true</_PixelyPublishWritesBrotli>
            <_PixelyBrowserBrotli>false</_PixelyBrowserBrotli>
            <_PixelyBrowserBrotli Condition="'$(PixelyBrowserBrotli)' == 'true' and '$(_PixelyPublishWritesBrotli)' == 'true'">true</_PixelyBrowserBrotli>
        </PropertyGroup>
        <Warning Code="PIXELY0012" File="$(MSBuildProjectFullPath)" Condition="'$(PixelyBrowserBrotli)' == 'true' and '$(_PixelyPublishWritesBrotli)' != 'true'"
                 Text="PixelyBrowserBrotli has no effect: this publish writes no .br files, because CompressionEnabled is not true or PublishCompressionFormats has no brotli." />
        <WriteLinesToFile File="$(_PixelyBrowserBootConfigExtension)" Lines="{ &quot;brotli&quot;: $(_PixelyBrowserBrotli) }" Overwrite="true" WriteOnlyWhenDifferent="true" />
        <ItemGroup>
            <WasmBootConfigExtension Include="$(_PixelyBrowserBootConfigExtension)" Key="pixely" />
            <FileWrites Include="$(_PixelyBrowserBootConfigExtension)" />
        </ItemGroup>
    </Target>

    <!--
      Every definition of ResolveStaticWebAssetsInputsDependsOn keeps the previous value, and the WebAssembly pack's targets, imported
      after this file, append _AddWasmStaticWebAssets, which runs ComputeWasmVfs; the Pixely target stays ahead of it. A publish
      without build and a design-time build leave it out of the graph, because MSBuild runs targets that name it in BeforeTargets or
      AfterTargets even when its own condition is false; both properties are global, so they are known here.
    -->
    <PropertyGroup Condition="'$(_PixelyBrowser)' == 'true' and '$(NoBuild)' != 'true' and '$(DesignTimeBuild)' != 'true'">
        <ResolveStaticWebAssetsInputsDependsOn>$(ResolveStaticWebAssetsInputsDependsOn);PixelyBrowserContent</ResolveStaticWebAssetsInputsDependsOn>
    </PropertyGroup>

    <!--
      A PixelyBrowserVfsFile is a file the browser app finds in its file system at startup, at TargetPath below /, which is
      AppContext.BaseDirectory there; Content.pk3 at TargetPath Content.pk3 is what UseDefaultContent() loads. Each file becomes a
      static web asset tagged for the file system. Pixely tags it, so the tag is in the build manifest that the nested publish build
      and a publish without build reload; it is also listed in WasmFilesToIncludeInFileSystem because only ComputeWasmVfs output
      reaches the build boot config. The target depends on Compile, so generated content exists when a producer listed in
      PixelyBrowserContentDependsOn packages it, also when ResolveStaticWebAssetsInputs is invoked directly.

      TargetPath is checked against an allowlist because ComputeWasmVfs uses it as a RelativePathFilter pattern. _framework and
      _content are reserved in any case: the WebAssembly assets there are defined later, package assets elsewhere, and a
      case-insensitive file system merges the folders. Only valid paths reach the later checks, which put TargetPath into property
      functions, where a quote would break the expression. They compare it with the static web assets defined so far, fingerprint
      expressions removed and a quote in their paths replaced: with their served paths, because two assets with one path fail
      manifest generation, and with their relative paths, because ComputeWasmVfs matches every asset by relative path, also one of a
      referenced project or package below _content/. A path that one asset needs as a file and another as a folder fails staging or
      publish. All checks ignore case although the file system does not: MSBuild batches metadata values ignoring case, so
      ComputeWasmVfs and the tagging below would put two target paths that differ only in case into one batch.
    -->
    <Target Name="PixelyBrowserContent" DependsOnTargets="Compile;$(PixelyBrowserContentDependsOn)"
            Condition="'$(_PixelyBrowser)' == 'true' and '$(NoBuild)' != 'true' and '$(DesignTimeBuild)' != 'true'">
        <PropertyGroup>
            <_PixelyBrowserVfsTargetPathPattern>^(?!(?i:_framework|_content)(/|$))(?!(.*/)?\.{1,2}(/|$))[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$</_PixelyBrowserVfsTargetPathPattern>
            <_PixelyBrowserVfsRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'pixely-browser-vfs'))</_PixelyBrowserVfsRoot>
        </PropertyGroup>
        <ItemGroup>
            <PixelyBrowserVfsFile Update="@(PixelyBrowserVfsFile)" Condition="'%(PixelyBrowserVfsFile.TargetPath)' == ''" TargetPath="%(Filename)%(Extension)" />
            <_PixelyMissingBrowserVfsFile Include="@(PixelyBrowserVfsFile)" Condition="!Exists('%(FullPath)')" />
            <!-- On Unix an item spec turns a backslash into a slash, so a backslash and a quote reach the check as '?', which it rejects. -->
            <_PixelyCheckedBrowserVfsTargetPath Include="@(PixelyBrowserVfsFile->Metadata('TargetPath')->Replace('\', '?')->Replace(&quot;'&quot;, '?'))" />
            <_PixelyInvalidBrowserVfsTargetPath Include="@(_PixelyCheckedBrowserVfsTargetPath)" Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('%(Identity)', '$(_PixelyBrowserVfsTargetPathPattern)'))" />
        </ItemGroup>
        <Error Code="PIXELY0010" File="$(MSBuildProjectFullPath)" Condition="'@(_PixelyMissingBrowserVfsFile)' != ''"
               Text="PixelyBrowserVfsFile @(_PixelyMissingBrowserVfsFile->'%(Identity)', ', ') does not exist; produce it in a target listed in PixelyBrowserContentDependsOn." />
        <Error Code="PIXELY0011" File="$(MSBuildProjectFullPath)" Condition="'@(_PixelyInvalidBrowserVfsTargetPath)' != ''"
               Text="PixelyBrowserVfsFile TargetPath @(_PixelyInvalidBrowserVfsTargetPath->'%(TargetPath)', ', ') is not a relative path of segments made of A-Z, a-z, 0-9, '.', '_' and '-' separated by '/', has a '.' or '..' segment, or is _framework or _content or below them, in any case." />
        <ItemGroup>
            <_PixelyBrowserVfsTargetPath Include="@(PixelyBrowserVfsFile->Metadata('TargetPath'))" />
            <_PixelyDuplicateBrowserVfsTargetPath Include="@(_PixelyBrowserVfsTargetPath)" Condition="'@(_PixelyBrowserVfsTargetPath->Count())' &gt; 1 and '%(Identity)' != ''" />
            <_PixelyStaticWebAssetPathSource Include="@(StaticWebAsset->'%(BasePath)/%(RelativePath)'->Replace(&quot;'&quot;, '?'))" />
            <_PixelyStaticWebAssetPath Include="$([System.Text.RegularExpressions.Regex]::Replace('%(_PixelyStaticWebAssetPathSource.Identity)', '#\[[^\]]*\][?!]?', '').Trim('/').Replace('//', '/'))" />
            <_PixelyStaticWebAssetRelativePathSource Include="@(StaticWebAsset->Metadata('RelativePath')->Replace(&quot;'&quot;, '?'))" />
            <_PixelyStaticWebAssetRelativePath Include="$([System.Text.RegularExpressions.Regex]::Replace('%(_PixelyStaticWebAssetRelativePathSource.Identity)', '#\[[^\]]*\][?!]?', '').Trim('/'))" />
            <_PixelyBrowserVfsServedPath Include="$([System.String]::Copy('$(StaticWebAssetBasePath)/%(PixelyBrowserVfsFile.TargetPath)').Trim('/').Replace('//', '/'))" TargetPath="%(PixelyBrowserVfsFile.TargetPath)" />
            <_PixelyFreeBrowserVfsServedPath Include="@(_PixelyBrowserVfsServedPath)" />
            <_PixelyFreeBrowserVfsServedPath Remove="@(_PixelyStaticWebAssetPath)" />
            <_PixelyCollidingBrowserVfsServedPath Include="@(_PixelyBrowserVfsServedPath)" />
            <_PixelyCollidingBrowserVfsServedPath Remove="@(_PixelyFreeBrowserVfsServedPath)" />
            <_PixelyFreeBrowserVfsTargetPath Include="@(_PixelyBrowserVfsTargetPath)" />
            <_PixelyFreeBrowserVfsTargetPath Remove="@(_PixelyStaticWebAssetRelativePath)" />
            <_PixelyCollidingBrowserVfsTargetPath Include="@(_PixelyCollidingBrowserVfsServedPath->'%(TargetPath)')" />
            <_PixelyCollidingBrowserVfsTargetPath Include="@(_PixelyBrowserVfsTargetPath)" Exclude="@(_PixelyFreeBrowserVfsTargetPath)" />
        </ItemGroup>
        <!-- Each list is joined between '|', lowercased, so '|path/' finds a path that has a folder of that name. -->
        <PropertyGroup>
            <_PixelyBrowserVfsServedPaths>|@(_PixelyBrowserVfsServedPath->ToLowerInvariant(), '|')|</_PixelyBrowserVfsServedPaths>
            <_PixelyServedPaths>|@(_PixelyStaticWebAssetPath->ToLowerInvariant(), '|')$(_PixelyBrowserVfsServedPaths)</_PixelyServedPaths>
        </PropertyGroup>
        <ItemGroup>
            <_PixelyFolderBrowserVfsServedPath Include="@(_PixelyBrowserVfsServedPath)" Condition="$(_PixelyServedPaths.Contains($([System.String]::Copy('|%(Identity)/').ToLowerInvariant())))" />
            <_PixelyFolderStaticWebAssetPath Include="@(_PixelyStaticWebAssetPath)" Condition="$(_PixelyBrowserVfsServedPaths.Contains($([System.String]::Copy('|%(Identity)/').ToLowerInvariant())))" />
        </ItemGroup>
        <Error Code="PIXELY0011" File="$(MSBuildProjectFullPath)" Condition="'@(_PixelyDuplicateBrowserVfsTargetPath)' != ''"
               Text="Two PixelyBrowserVfsFile items share a TargetPath, ignoring case: @(_PixelyDuplicateBrowserVfsTargetPath, ', ')." />
        <Error Code="PIXELY0011" File="$(MSBuildProjectFullPath)" Condition="'@(_PixelyCollidingBrowserVfsTargetPath)' != ''"
               Text="PixelyBrowserVfsFile TargetPath @(_PixelyCollidingBrowserVfsTargetPath->Distinct(), ', ') is already the path of a static web asset: a wwwroot file, a linked or generated asset, a file of the default page, or an asset of a referenced project or package with that relative path." />
        <Error Code="PIXELY0011" File="$(MSBuildProjectFullPath)" Condition="'@(_PixelyFolderBrowserVfsServedPath)' != ''"
               Text="PixelyBrowserVfsFile TargetPath @(_PixelyFolderBrowserVfsServedPath->'%(TargetPath)', ', ') is a file, but another PixelyBrowserVfsFile or a static web asset needs it as a folder, ignoring case." />
        <Error Code="PIXELY0011" File="$(MSBuildProjectFullPath)" Condition="'@(_PixelyFolderStaticWebAssetPath)' != ''"
               Text="Static web asset @(_PixelyFolderStaticWebAssetPath, ', ') is a file, but a PixelyBrowserVfsFile TargetPath needs it as a folder, ignoring case." />
        <!-- The copy gives each asset a content root whose relative path is its TargetPath, as for the default page. -->
        <Copy SourceFiles="@(PixelyBrowserVfsFile)" DestinationFiles="@(PixelyBrowserVfsFile->'$(_PixelyBrowserVfsRoot)%(TargetPath)')" SkipUnchangedFiles="true" />
        <ItemGroup>
            <!-- Only TargetPath is kept: DefineStaticWebAssets prefers candidate metadata such as RelativePath over its parameters. -->
            <_PixelyBrowserVfsAsset Include="@(PixelyBrowserVfsFile->'$(_PixelyBrowserVfsRoot)%(TargetPath)')" KeepMetadata="TargetPath" />
            <_PixelyBrowserVfsAsset Update="@(_PixelyBrowserVfsAsset)" OriginalItemSpec="%(Identity)" />
            <FileWrites Include="@(_PixelyBrowserVfsAsset)" />
        </ItemGroup>
        <!-- Batched per TargetPath, as ComputeWasmVfs does. Not fingerprinted: ComputeWasmVfs matches by relative path, and the boot config pins the file by its integrity hash. -->
        <DefineStaticWebAssets CandidateAssets="@(_PixelyBrowserVfsAsset)" SourceId="$(PackageId)" SourceType="Computed" ContentRoot="$(_PixelyBrowserVfsRoot)"
                               BasePath="$(StaticWebAssetBasePath)" AssetKind="All" AssetTraitName="WasmResource" AssetTraitValue="vfs:%(_PixelyBrowserVfsAsset.TargetPath)"
                               Condition="'@(_PixelyBrowserVfsAsset)' != ''">
            <Output TaskParameter="Assets" ItemName="StaticWebAsset" />
            <Output TaskParameter="Assets" ItemName="_PixelyBrowserVfsStaticWebAsset" />
        </DefineStaticWebAssets>
        <DefineStaticWebAssetEndpoints CandidateAssets="@(_PixelyBrowserVfsStaticWebAsset)" ContentTypeMappings="@(StaticWebAssetContentTypeMapping)" Condition="'@(_PixelyBrowserVfsAsset)' != ''">
            <Output TaskParameter="Endpoints" ItemName="StaticWebAssetEndpoint" />
        </DefineStaticWebAssetEndpoints>
        <ItemGroup>
            <WasmFilesToIncludeInFileSystem Include="@(PixelyBrowserVfsFile->'%(TargetPath)')" />
        </ItemGroup>
    </Target>
</Project>
