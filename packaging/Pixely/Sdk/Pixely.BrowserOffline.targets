<Project>
    <!--
      PixelyBrowserOffline publishes an offline worker through the .NET SDK's own service worker targets, which the static web
      assets SDK imports from the WebAssembly targets only when ServiceWorkerAssetsManifest is set. So this file is imported right
      before them, after Directory.Build.targets. The SDK serves the worker at the ServiceWorker item's path below wwwroot/, in a
      publish from its PublishedContent: the package's worker or a project's own wwwroot/service-worker.js. A build serves a worker,
      and an assets list, only when that project file exists.
    -->
    <PropertyGroup Condition="'$(_PixelyBrowser)' == 'true' and '$(PixelyBrowserOffline)' == 'true'">
        <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
        <_PixelyBrowserOfflineWorker>$(MSBuildThisFileDirectory)..\wwwroot\service-worker.js</_PixelyBrowserOfflineWorker>
        <_PixelyBrowserOfflineWorker Condition="Exists('$(MSBuildProjectDirectory)/wwwroot/service-worker.js')">$(MSBuildProjectDirectory)/wwwroot/service-worker.js</_PixelyBrowserOfflineWorker>
    </PropertyGroup>
    <ItemGroup Condition="'$(_PixelyBrowser)' == 'true' and '$(PixelyBrowserOffline)' == 'true'">
        <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="$(_PixelyBrowserOfflineWorker)" />
    </ItemGroup>
</Project>
