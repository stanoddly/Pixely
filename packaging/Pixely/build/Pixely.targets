<Project>
    <!--
      Imported by a PackageReference to Pixely, which the SDK itself declares for every consumer; the SDK resolver never
      imports build/. Both the import and the target are conditioned on the SDK marker so an SDK consumer imports the
      version props once (MSB4011) and builds. build/ is excluded during restore, so the build is the earliest hook.
    -->
    <Import Project="$(MSBuildThisFileDirectory)..\Sdk\Pixely.Version.props" Condition="'$(_PixelySdkImported)' != 'true'" />

    <Target Name="_PixelyRejectPackageReference" BeforeTargets="BeforeBuild" Condition="'$(_PixelySdkImported)' != 'true'">
        <Error Text="Pixely is an MSBuild project SDK. Replace &lt;PackageReference Include=&quot;Pixely&quot; /&gt; with &lt;Sdk Name=&quot;Pixely&quot; Version=&quot;$(PixelyVersion)&quot; /&gt;." />
    </Target>
</Project>
