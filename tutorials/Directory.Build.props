<Project>

    <!-- A portable build copies every SDL3 native RID into bin/ (about 210 MB per project). Only the host RID is ever loaded, so pin it. -->
    <!-- NETCoreSdkRuntimeIdentifier is set by the SDK before this file is imported. -->
    <!-- On net8.0+ a RuntimeIdentifier no longer implies SelfContained, so it is left unset for PublishAot to infer. -->
    <!-- -r browser-wasm is a global property and wins over the assignment below. -->
    <PropertyGroup>
        <RuntimeIdentifier>$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    </PropertyGroup>

    <!--
      Tutorials reference Pixely as a project, so the Pixely SDK is not imported. Its browser props are imported on the
      hook at the end of Microsoft.NET.Sdk.props, after nuget.g.props has set _WebAssemblyPropsFile; a direct import from
      this file would run before it. The props file registers Pixely.Browser.targets on BeforeMicrosoftNETSdkTargets itself.
    -->
    <PropertyGroup>
        <AfterMicrosoftNetSdkProps>$(AfterMicrosoftNetSdkProps);$(MSBuildThisFileDirectory)..\packaging\Pixely\Sdk\Pixely.Browser.props</AfterMicrosoftNetSdkProps>
    </PropertyGroup>

</Project>
