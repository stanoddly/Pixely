<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PublishAot>true</PublishAot>
        <InterceptorsNamespaces>$(InterceptorsNamespaces);Pixely.DependencyInjection.Generated</InterceptorsNamespaces>
        <PixelyHosting>true</PixelyHosting>
        <ContentSourceDirectory>$(MSBuildProjectDirectory)/Content</ContentSourceDirectory>
    </PropertyGroup>

    <!--
      The browser needs SDL3 linked into the runtime (docs/hosting.md): point BrowserNativeLibraryDirectory at a directory
      of Emscripten static libraries named after their P/Invoke modules (SDL3.a at least) when publishing for browser-wasm.
      Passed with -p it is a global property, which a project cannot reassign, so the normalized value lives in its own property.
      The triangle needs SDL's WebGPU backend, so that SDL3.a is built from stanoddly/SDL_wgpu and the publish opts into the
      WebGPU binding with PixelyBrowserWebGpu=true and a writable WasmCachePath (docs/hosting.md, WebGPU in the browser).
    -->
    <PropertyGroup Condition="'$(BrowserNativeLibraryDirectory)' != ''">
        <_BrowserNativeLibraryDirectory>$([MSBuild]::EnsureTrailingSlash('$(BrowserNativeLibraryDirectory)'))</_BrowserNativeLibraryDirectory>
    </PropertyGroup>

    <ItemGroup Condition="'$(_BrowserNativeLibraryDirectory)' != ''">
        <NativeFileReference Include="$(_BrowserNativeLibraryDirectory)*.a" />
    </ItemGroup>

    <!-- An empty glob would publish a bundle that fails at run time. -->
    <Target Name="_RequireBrowserSdlLibrary" BeforeTargets="BeforeBuild" Condition="'$(_BrowserNativeLibraryDirectory)' != '' and !Exists('$(_BrowserNativeLibraryDirectory)SDL3.a')">
        <Error Text="BrowserNativeLibraryDirectory $(_BrowserNativeLibraryDirectory) has no SDL3.a; see docs/hosting.md, SDL3 in the browser." />
    </Target>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Pixely\Pixely.csproj" />
        <ProjectReference Include="..\..\src\Pixely.DependencyInjection\Pixely.DependencyInjection.csproj" />
        <ProjectReference Include="..\..\src\Pixely.DependencyInjection.Generator\Pixely.DependencyInjection.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\..\src\Pixely.SdlangCompiler\Pixely.SdlangCompiler.csproj" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <Import Project="..\..\src\Pixely.SdlangCompiler\build\Pixely.SdlangCompiler.props" />
    <Import Project="..\..\src\Pixely.SdlangCompiler\build\Pixely.SdlangCompiler.targets" />

    <ItemGroup>
        <SdlangShader Include="Content\shaders\*.slang" />
    </ItemGroup>

    <!--
      A content directory beside the executable has no browser counterpart, so the generated shaders are embedded in the
      assembly under their content paths (the recipe of Pixely.Tutorials.EmbeddedContent), on both hosts so one Configure
      serves both. The browser bundle carries only the WGSL and the metadata; the desktop keeps every format.
    -->
    <Target Name="EmbedShaderOutputs" BeforeTargets="AssignTargetPaths" DependsOnTargets="CompileSdlangShaders" Condition="'$(NoBuild)' != 'true'">
        <ItemGroup>
            <_ShaderResource Include="@(SdlangShaderOutput)" Condition="'$(_PixelyBrowser)' != 'true' or '%(Extension)' == '.wgsl' or '%(Extension)' == '.json'">
                <ContentRelativePath>$([MSBuild]::MakeRelative('$(ContentSourceDirectory)', '%(FullPath)'))</ContentRelativePath>
            </_ShaderResource>
            <EmbeddedResource Include="@(_ShaderResource)">
                <WithCulture>false</WithCulture>
                <LogicalName>$([System.String]::Copy('%(ContentRelativePath)').Replace('\', '/'))</LogicalName>
            </EmbeddedResource>
        </ItemGroup>
    </Target>

</Project>
