+                pendingKeyword = "@group";
+            } else {
+                token = groupToken;
+                pendingKeyword = "@binding";
+            }
+        } else if (keywordProgress == 1) {
+            token = SDL_strstr(trimmedView, pendingKeyword);
+        } else {
+            token = SDL_strstr(trimmedView, keywords[keywordProgress]);
+        }
 
         if (token == NULL) {
             keywordProgress = 0;
